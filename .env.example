APP_NAME=managementApp Python API
API_PREFIX=/api

# Opción 1 (recomendada): URL completa
# DATABASE_URL=postgresql+psycopg://root:password@localhost:5432/spring

# Opción 2: construir URL con variables separadas
USE_POSTGRES=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spring
DB_USER=root
DB_PASSWORD=password
DB_ECHO=false

# Scheduler de estados
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
TASK_CREATED_TO_RUNNING_MINUTES=2
TASK_RUNNING_TO_DONE_MINUTES=8
